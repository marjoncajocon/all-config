export PATH="$PATH:$USB_DRIVE/mmc-shell/home/marjoncajocon/app/Zed_123"
export PATH="$PATH:$USB_DRIVE/mmc-shell/home/marjoncajocon/app/sublime_merge_build_2125_x64"

# npm overide environment
export npm_config_cache="$USB_DRIVE/env/node/npm-home/npm-cache"
export npm_config_init_module="$USB_DRIVE/env/node/npm-home"
export npm_config_local_prefix="$USB_DRIVE/env/node/npm-home"
export npm_config_userconfig="$USB_DRIVE/env/node/npm-home"
