# neovim|nvim
export PATH="$PATH:$USB_DRIVE/env/nvim-win64/bin"
export XDG_CONFIG_HOME="$USB_DRIVE/env/nvim-win64/nvim-data/config"
export XDG_DATA_HOME="$USB_DRIVE/env/nvim-win64/nvim-data/data"
